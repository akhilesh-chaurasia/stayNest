<% layout('layouts/boilerplate') %>
<!-- <%= success %> isko ham bootstrap class ke thorow impliment karenge in boilerplate ke ander  -->
<body>
  <!-- <h3>All Listings</h3> -->
   <!-- for icons -->

   <style>
    p{
      font-size: 1rem;
      text-shadow: 1em;
    }
    #filters{
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }
    .filters-left{
      display: flex;
      flex-wrap: wrap;
    }
    .filter{
      text-align: center;
      margin-right: 2rem;
      margin-top: 2rem;
      opacity: 0.7;
      text-decoration: none;
      color: inherit;
    }
    
    .filter:hover{
      opacity: 1;
      cursor: pointer;
    }
    .text-info{
      display: none;
    }
    .text-toggle{
      border: 1px solid black;
      border-radius: 1rem;
      height: 2.5rem;
      padding: 1rem;
      margin-right: 6rem;
      display: flex;
      align-items: center;
      
    }
    .text-toggle{
  margin-left: auto;
}
</style>

<div id="filters">

  <!-- LEFT SIDE : all category icons -->
   <div class="filters-left">
<div class="filters-left d-flex gap-3">
  <% CATEGORIES.forEach(element => { %>
    <a 
      href="/listings?category=<%= element.name %>"
      class="filter text-decoration-none text-center px-2
        <%= category === element.name ? 'text-danger fw-semibold border-bottom border-danger' : 'text-muted' %>"
    >
      <i class="fa-solid <%= element.icon %> fs-5"></i>
      <p class="mb-0 small"><%= element.name %></p>
    </a>
  <% }) %>
</div>



  </div>

  <!-- RIGHT SIDE : toggle -->
  <div class="text-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">
        Display total after taxes
      </label>
    </div>
  </div>

</div>


 <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
     <% for(let listing of allListings){ %>

      <!-- image pe cleck karke show.ejs pe jane ke liye ak anker tag me sate listing ko dal diya  -->
     <a href="/listings/<%= listing._id %>" class="listing-link">
       <div class="card" style="width: 20rem;">
      <img 
        src="<%= listing.image.url %>" 
        class="card-img-top" 
        alt="listing_image" 
        style="height:20rem ;"
        />
        <!-- card image overlay maine bootstrap se liya hai ye 
         image ke uper text likhne ke liye use kiya gya hai -->
           <div class="card-img-overlay"></div>

      <div class="card-body">
        <p class="card-text">
        <b><%= listing.title %></b><br/>
        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
        <i class="text-info"> &nbsp; &nbsp;+18% GST</i>
        </p>
      </div>
    </div>

     </a>   

  <% } %>
 </div>

<script>
  let textSwitch = document.getElementById("switchCheckDefault");
  textSwitch.addEventListener("click",()=>{
    let textInfo = document.getElementsByClassName("text-info");
    for(info of textInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline";
      } else{
        info.style.display = "none";
      }
    }
  });
</script>
</body>
